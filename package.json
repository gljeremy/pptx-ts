{
  "name": "@gljeremy/pptx-ts",
  "version": "0.1.0",
  "description": "TypeScript port of python-pptx: create, read and update PowerPoint (.pptx) files in browsers and Node",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ole-icons": {
      "types": "./dist/ole-icons.d.ts",
      "import": "./dist/ole-icons.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates/*.emf"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:build": "esbuild dist/index.js --bundle --platform=browser --format=iife --global-name=pptx --minify --outfile=demo/pptx.js",
    "check:bundle": "node scripts/check_bundle.mjs",
    "prepack": "npm run build",
    "check:pack": "node scripts/check_pack.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gljeremy/pptx-ts.git"
  },
  "homepage": "https://github.com/gljeremy/pptx-ts#readme",
  "bugs": "https://github.com/gljeremy/pptx-ts/issues",
  "keywords": [
    "pptx",
    "powerpoint",
    "python-pptx",
    "office",
    "openxml",
    "presentation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
