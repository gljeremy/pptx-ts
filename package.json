{
  "name": "pptx-ts",
  "version": "0.1.0",
  "description": "TypeScript port of python-pptx: create, read and update PowerPoint (.pptx) files in browsers and Node",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:build": "esbuild dist/index.js --bundle --platform=browser --format=iife --global-name=pptx --minify --outfile=demo/pptx.js"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.16"
  }
}
